#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <150>;
};

&mt {
    tapping-term-ms = <175>;
    flavor = "tap-preferred";
};

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hmLeft: hmLeft {
            compatible = "zmk,behavior-hold-tap";
            label = "HMLEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 36 37 38>;
        };

        hmRight: hmRight {
            compatible = "zmk,behavior-hold-tap";
            label = "HMRIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
        };

        // auto shift: 짧게 누르면 기본 자모, 길게 누르면 Shift 조합(쌍자음 ㅃㅉㄸㄲㅆ, 모음 ㅒㅖ)

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
        };

        // 조합키 전용 hold-tap: 홀드 시 매크로로 한 번만 tap (auto-repeat 없음)

        mts: mt_shot {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_SHOT";
            bindings = <&shot>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "tap-preferred";
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };

        // 파라미터로 받은 키코드를 한 번만 tap (auto-repeat 방지용)

        shot: shot {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "SHOT";
        };
    };

    combos {
        compatible = "zmk,combos";

        cb_enter {
            bindings = <&kp ENTER>;
            key-positions = <17 18>;
        };

        cb_bt_layer {
            bindings = <&mo 5>;
            key-positions = <36 37>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        cb_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        cb_backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        cb_tab {
            bindings = <&kt TAB>;
            key-positions = <10 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&as LS(Q) Q      &as LS(W) W          &as LS(E) E                  &as LS(R) R     &as LS(T) T                               &kp Y      &kp U            &kp I                &as LS(O) O         &as LS(P) P
&mt CAPS A       &kp S                &kp D                        &kp F           &kp G                                     &kp H      &kp J            &kp K                &kp L               &as COLON SEMICOLON
&hmLeft LSHFT Z  &hmLeft LCTRL X      &hmLeft LALT C               &hmLeft LGUI V  &kp B                                     &kp N      &hmRight RGUI M  &hmRight RALT COMMA  &hmRight RCTRL DOT  &hmRight RSHFT SLASH
&lt 1 LG(LS(C))  &mt LEFT_ALT DELETE  &mt LEFT_COMMAND LG(LS(N4))  &lt 3 CAPS      &lt 2 ESCAPE  &lt 4 TAB  &lt 2 BACKSPACE  &kp SPACE                                                            &kp ENTER
            >;
        };

        macro {
            label = "macro";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6  &kp NUMBER_7   &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&trans        &trans        &trans        &trans        &trans                        &kp LEFT      &kp DOWN       &kp UP        &kp RIGHT     &none
&trans        &trans        &trans        &trans        &trans                        &kp DEL       &kp BACKSPACE  &trans        &trans        &mo 3
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans                                                   &kp ENTER
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&mts LG(Q) EXCLAMATION  &mts LG(W) AT_SIGN  &kp HASH   &mts LG(R) DOLLAR  &kp PERCENT                     &kp CARET       &kp AMPERSAND                &kp ASTERISK          &mts LG(O) LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS
&kp GRAVE               &kp TILDE           &mo 3      &kp PIPE           &kp BACKSLASH                   &as PLUS EQUAL  &as LEFT_BRACE LEFT_BRACKET  &as UNDERSCORE MINUS  &as RIGHT_BRACE RIGHT_BRACKET  &as DOUBLE_QUOTES SQT
&trans                  &trans              &kp LG(C)  &kp LG(V)          &kp UNDERSCORE                  &kp DEL         &kp BACKSPACE                &kp LESS_THAN         &kp GREATER_THAN               &kp QUESTION
&trans                  &trans              &trans     &trans             &trans          &trans  &trans  &trans                                                                                            &kp LS(ENTER)
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &none                   &none     &none     &none   &none      &none
&kp F5  &kp F6   &kp F7   &kp F8   &none                   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none
&kp F9  &kp F10  &kp F11  &kp F12  &none                   &none     &none     &none   &none      &none
&trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans                                 &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                      &kp NUMBER_6    &kp NUMBER_7   &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&trans        &trans        &mkp MB2      &mkp MB1      &msc SCRL_UP                      &kp LEFT_ARROW  &kp DOWN       &kp UP        &kp RIGHT     &trans
&trans        &trans        &trans        &trans        &msc SCRL_DOWN                    &kp DELETE      &kp BACKSPACE  &mkp MB1      &mkp MB2      &trans
&trans        &trans        &trans        &trans        &trans          &trans  &mkp MB4  &mkp MB5                                                   &trans
            >;
        };

        bluetooth {
            label = "blue";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &bt BT_SEL 4    &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
&bt BT_CLR    &trans        &trans        &trans        &bt BT_CLR_ALL                  &bt BT_CLR_ALL  &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans                          &trans          &trans        &trans        &trans        &trans
&bootloader   &trans        &trans        &trans        &trans          &trans  &trans  &trans                                                    &bootloader
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };
    };
};
